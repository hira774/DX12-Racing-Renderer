# テスト用の立方体（0-6 タスク1）
# 右手系（+Y が上、+Z が手前）、表の面は反時計回り。1辺 1.0、中心が原点
# 面ごとに UV が 0〜1 になるので、どの面にもテクスチャ全体が1枚ずつ貼られる

# 位置
v -0.5 -0.5  0.5
v  0.5 -0.5  0.5
v -0.5  0.5  0.5
v  0.5  0.5  0.5
v -0.5  0.5 -0.5
v  0.5  0.5 -0.5
v -0.5 -0.5 -0.5
v  0.5 -0.5 -0.5

# UV（OBJ では v が上向き。左下が (0, 0)）
vt 0.0 0.0
vt 1.0 0.0
vt 0.0 1.0
vt 1.0 1.0

# 法線
vn  0.0  0.0  1.0
vn  0.0  1.0  0.0
vn  0.0  0.0 -1.0
vn  0.0 -1.0  0.0
vn  1.0  0.0  0.0
vn -1.0  0.0  0.0

# 面（位置/UV/法線 の番号。番号は 1 から始まる）
# +Z
f 1/1/1 2/2/1 3/3/1
f 3/3/1 2/2/1 4/4/1
# +Y
f 3/1/2 4/2/2 5/3/2
f 5/3/2 4/2/2 6/4/2
# -Z
f 5/4/3 6/3/3 7/2/3
f 7/2/3 6/3/3 8/1/3
# -Y
f 7/1/4 8/2/4 1/3/4
f 1/3/4 8/2/4 2/4/4
# +X
f 2/1/5 8/2/5 4/3/5
f 4/3/5 8/2/5 6/4/5
# -X
f 7/1/6 1/2/6 5/3/6
f 5/3/6 1/2/6 3/4/6
